{% extends 'base.html.twig' %}

{% block title %}Mon espace — Il nous manque un joueur{% endblock %}

{% block body %}
    <h1>Mon espace</h1>
    <p>Bonjour {{ app.user.pseudo }} !</p>

    <p><a href="{{ path('app_rencontre_new') }}">Organiser une rencontre</a></p>
    <p><a href="{{ path('app_rencontre') }}">Voir les rencontres à venir</a></p>

    <h2>Mes rencontres organisées</h2>

    {% for rencontre in rencontres %}
        <article>
            <h3><a href="{{ path('app_rencontre_show', {id: rencontre.id}) }}">{{ rencontre.titre }}</a></h3>
            <p>{{ rencontre.ville }} — {{ rencontre.dateHeure|date('d/m/Y à H:i', 'Europe/Paris') }}</p>
            <p>Places restantes : {{ rencontre.placesRestantes }} sur {{ rencontre.placesRecherchees }}</p>
        </article>
    {% else %}
        <p>Vous n’avez encore organisé aucune rencontre.</p>
    {% endfor %}

    <h2>Mes demandes de participation</h2>

    {% for participation in participations %}
        <article>
            <h3><a href="{{ path('app_rencontre_show', {id: participation.rencontre.id}) }}">{{ participation.rencontre.titre }}</a></h3>
            <p>{{ participation.rencontre.ville }} — {{ participation.rencontre.dateHeure|date('d/m/Y à H:i', 'Europe/Paris') }}</p>

            {% if participation.statut == constant('App\\Entity\\Participation::STATUT_EN_ATTENTE') %}
                <p>Statut : en attente</p>
            {% elseif participation.statut == constant('App\\Entity\\Participation::STATUT_ACCEPTEE') %}
                <p>Statut : acceptée</p>
            {% elseif participation.statut == constant('App\\Entity\\Participation::STATUT_REFUSEE') %}
                <p>Statut : refusée</p>
            {% endif %}
        </article>
    {% else %}
        <p>Vous n’avez encore envoyé aucune demande.</p>
    {% endfor %}
{% endblock %}