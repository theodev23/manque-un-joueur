{# Pictogrammes décoratifs : le texte voisin reste toujours présent. #}
{% macro icon(name) %}
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'pin' %}
            <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="2.5"/>
        {% elseif name == 'pitch' %}
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M12 4v16M3 8h3v8H3m18-8h-3v8h3"/>
            <circle cx="12" cy="12" r="3"/>
        {% elseif name == 'calendar' %}
            <rect x="3" y="5" width="18" height="16" rx="2"/>
            <path d="M16 3v4M8 3v4M3 11h18M8 15h2m4 0h2M8 18h2"/>
        {% elseif name == 'players' %}
            <circle cx="9" cy="8" r="3"/>
            <path d="M3 21v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 4v2"/>
        {% elseif name == 'arrow' %}
            <path d="M4 12h16m-6-6 6 6-6 6"/>
        {% endif %}
    </svg>
{% endmacro %}
