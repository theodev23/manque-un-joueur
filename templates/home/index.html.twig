{% extends 'base.html.twig' %}

{% block title %}Il nous manque un joueur{% endblock %}

{% block body %}
    <h1>Il nous manque un joueur</h1>

    <p>Un match prévu, mais une équipe incomplète ? Publiez votre rencontre et trouvez les joueurs manquants.</p>

    <p><a href="{{ path('app_rencontre') }}">Trouver une rencontre</a></p>

    {% if app.user %}
        <p><a href="{{ path('app_rencontre_new') }}">Organiser une rencontre</a></p>
        <p><a href="{{ path('app_espace_personnel') }}">Retrouver mes rencontres et mes demandes</a></p>
    {% else %}
        <p><a href="{{ path('app_register') }}">Créer un compte pour rejoindre le jeu</a></p>
    {% endif %}

    <h2>Comment ça fonctionne ?</h2>

    <ol>
        <li>Créez votre compte.</li>
        <li>Proposez une rencontre ou demandez à rejoindre un match.</li>
        <li>Consultez la réponse de l’organisateur dans votre espace personnel.</li>
    </ol>
{% endblock %}