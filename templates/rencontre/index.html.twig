{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as icons %}

{% block title %}Les rencontres — Il nous manque un joueur{% endblock %}

{% block body %}
    <div class="page-heading">
        <div>
            <h1>Les rencontres à venir</h1>
            <p>Trouvez une rencontre et proposez votre participation. Horaires affichés à l’heure de Paris.</p>
        </div>

        <a class="btn" href="{{ path('app_rencontre_new') }}">Organiser une rencontre</a>
    </div>

    <form method="get" action="{{ path('app_rencontre') }}" class="search-form">
        <div class="search-field">
            <label for="ville">Ville</label>
            <input type="search" id="ville" name="ville" value="{{ ville }}" placeholder="Ex. : Montpellier" maxlength="100">
        </div>

        <button type="submit" class="btn">Rechercher</button>
        <a class="btn btn-secondary" href="{{ path('app_rencontre') }}">Réinitialiser</a>
    </form>

    <div class="cards-grid">
        {% for rencontre in rencontres %}
            {% set placesRestantes = rencontre.placesRestantes %}

            <article class="card meeting-card">
                {% if placesRestantes > 0 %}
                    <span class="badge badge-available">
                        {{ icons.icon('players') }}
                        {{ placesRestantes }} place{{ placesRestantes > 1 ? 's' : '' }} disponible{{ placesRestantes > 1 ? 's' : '' }}
                    </span>
                {% else %}
                    <span class="badge badge-full">Complet</span>
                {% endif %}

                <h2>
                    <a href="{{ path('app_rencontre_show', {id: rencontre.id}) }}">{{ rencontre.titre }}</a>
                </h2>

                <div class="card-details">
                    <p>{{ icons.icon('pin') }} <span><strong>Ville :</strong> {{ rencontre.ville }}</span></p>
                    <p>{{ icons.icon('pitch') }} <span><strong>Lieu :</strong> {{ rencontre.lieu }}</span></p>
                    <p>{{ icons.icon('calendar') }} <span><strong>Date :</strong> {{ rencontre.dateHeure|date('d/m/Y à H:i', 'Europe/Paris') }}</span></p>
                </div>

                <a class="btn btn-secondary" href="{{ path('app_rencontre_show', {id: rencontre.id}) }}">Voir la rencontre</a>
            </article>
        {% else %}
            <div class="empty-state">
                {% if ville != '' %}
                    <p>Aucune rencontre à venir à « {{ ville }} ». Essayez une autre ville ou réinitialisez la recherche.</p>
                {% else %}
                    <p>Aucune rencontre à venir pour le moment. Vous pouvez organiser la première !</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
