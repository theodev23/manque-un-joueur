{% extends 'base.html.twig' %}

{% block title %}{{ rencontre.titre }} — Il nous manque un joueur{% endblock %}

{% block body %}
    {% set placesRestantes = rencontre.placesRestantes %}
    {% set estOrganisateur = app.user and app.user.id == rencontre.organisateur.id %}

    <div class="page-heading">
        <div>
            <h1>{{ rencontre.titre }}</h1>
            <p>Organisée par {{ rencontre.organisateur.pseudo }}</p>
        </div>

        {% if not inscriptionsOuvertes %}
            <span class="badge badge-full">Inscriptions fermées</span>
        {% elseif placesRestantes <= 0 %}
            <span class="badge badge-full">Complet</span>
        {% else %}
            <span class="badge badge-available">
                {{ placesRestantes }} place{{ placesRestantes > 1 ? 's' : '' }} disponible{{ placesRestantes > 1 ? 's' : '' }}
            </span>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <section class="detail-panel">
        <h2>Informations sur la rencontre</h2>

        <dl class="meeting-details">
            <div>
                <dt>Ville</dt>
                <dd>{{ rencontre.ville }}</dd>
            </div>

            <div>
                <dt>Lieu</dt>
                <dd>{{ rencontre.lieu }}</dd>
            </div>

            <div>
                <dt>Date et heure</dt>
                <dd>{{ rencontre.dateHeure|date('d/m/Y à H:i', 'Europe/Paris') }} — heure de Paris</dd>
            </div>

            <div>
                <dt>Places restantes</dt>
                <dd>{{ placesRestantes }} sur {{ rencontre.placesRecherchees }}</dd>
            </div>
        </dl>

        {% if rencontre.description %}
            <div class="meeting-description">
                <h3>Informations complémentaires</h3>
                <p>{{ rencontre.description }}</p>
            </div>
        {% endif %}
    </section>

    <section class="detail-panel">
        <h2>Votre participation</h2>

        {% if estOrganisateur %}
            <p>Vous êtes l’organisateur de cette rencontre.</p>
            {% if inscriptionsOuvertes %}
                <a class="btn" href="{{ path('app_rencontre_edit', {id: rencontre.id}) }}">Modifier la rencontre</a>
            {% endif %}
        {% elseif participation %}
            {% if participation.statut == constant('App\\Entity\\Participation::STATUT_EN_ATTENTE') %}
                <p><span class="badge badge-pending">En attente</span></p>
                <p>Votre demande est en attente de réponse.</p>
            {% elseif participation.statut == constant('App\\Entity\\Participation::STATUT_ACCEPTEE') %}
                <p><span class="badge badge-available">Acceptée</span></p>
                <p>Votre demande a été acceptée.</p>
            {% elseif participation.statut == constant('App\\Entity\\Participation::STATUT_REFUSEE') %}
                <p><span class="badge badge-refused">Refusée</span></p>
                <p>Votre demande a été refusée.</p>
            {% endif %}

        {% elseif not inscriptionsOuvertes %}
            <p>Les inscriptions sont fermées : cette rencontre a déjà commencé.</p>

        {% elseif placesRestantes <= 0 %}
            <p>Cette rencontre est complète.</p>

        {% elseif app.user %}
            <form method="post" action="{{ path('app_rencontre_participer', {id: rencontre.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('participer_' ~ rencontre.id) }}">
                <button type="submit" class="btn">Demander à participer</button>
            </form>

        {% else %}
            <p>Connectez-vous pour demander à participer.</p>
            <a class="btn" href="{{ path('app_login') }}">Se connecter</a>
        {% endif %}
    </section>

    {% if estOrganisateur %}
        <section class="detail-panel">
            <h2>Demandes de participation</h2>

            {% if not inscriptionsOuvertes %}
                <p>Cette rencontre a déjà commencé : les demandes ne peuvent plus être traitées.</p>
            {% endif %}

            <div class="participation-list">
                {% for demande in demandes %}
                    <article class="participation-card">
                        <h3>{{ demande.utilisateur.pseudo }}</h3>
                        <p>Demande envoyée le {{ demande.dateDemande|date('d/m/Y à H:i', 'Europe/Paris') }} — heure de Paris</p>

                        {% if demande.statut == constant('App\\Entity\\Participation::STATUT_EN_ATTENTE') %}
                            <p><span class="badge badge-pending">En attente</span></p>

                            {% if inscriptionsOuvertes %}
                                {% if placesRestantes <= 0 %}
                                    <p>La rencontre est complète.</p>
                                {% endif %}

                                <div class="actions">
                                    {% if placesRestantes > 0 %}
                                        <form method="post" action="{{ path('app_participation_accepter', {id: demande.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accepter_' ~ demande.id) }}">
                                            <button type="submit" class="btn">Accepter</button>
                                        </form>
                                    {% endif %}

                                    <form method="post" action="{{ path('app_participation_refuser', {id: demande.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('refuser_' ~ demande.id) }}">
                                        <button type="submit" class="btn btn-secondary">Refuser</button>
                                    </form>
                                </div>
                            {% endif %}

                        {% elseif demande.statut == constant('App\\Entity\\Participation::STATUT_ACCEPTEE') %}
                            <p><span class="badge badge-available">Acceptée</span></p>

                        {% elseif demande.statut == constant('App\\Entity\\Participation::STATUT_REFUSEE') %}
                            <p><span class="badge badge-refused">Refusée</span></p>
                        {% endif %}
                    </article>
                {% else %}
                    <p>Aucune demande pour le moment.</p>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <a class="btn btn-secondary" href="{{ path('app_rencontre') }}">Retour aux rencontres</a>
{% endblock %}